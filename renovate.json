{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "helpers:pinGitHubActionDigests"
    ],
    "schedule": [
      "at any time"
    ],
    "baseBranchPatterns": ["main"],
    "lockFileMaintenance": {
        "enabled": true
    },
    "postUpdateOptions": ["gomodTidy"],
    "nix": {
        "enabled": true
    },
    "minimumReleaseAge": "1 day"
}
